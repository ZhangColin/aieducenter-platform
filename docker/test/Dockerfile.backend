# 后端测试容器 Dockerfile
# 在隔离的 Docker 环境中运行后端测试
# Build context: workspace/ (parent of aieducenter-platform-admin/)

# 设置 JVM TLS 选项（构建时和运行时都需要）
ARG JAVA_TOOL_OPTIONS=-Djdk.tls.client.protocols=TLSv1.2,TLSv1.3 -Dhttps.protocols=TLSv1.2,TLSv1.3 -Djavax.net.ssl.trustStore=NONE

FROM eclipse-temurin:21-jdk-jammy

# 继承构建参数
ENV JAVA_TOOL_OPTIONS=${JAVA_TOOL_OPTIONS}

# 预下载 Gradle 到本地
RUN apt-get update && \
    apt-get install -y --no-install-recommends unzip curl && \
    curl -fsSL https://services.gradle.org/distributions/gradle-8.5-bin.zip -o /tmp/gradle.zip && \
    unzip -q /tmp/gradle.zip -d /opt/ && \
    rm /tmp/gradle.zip && \
    ln -s /opt/gradle-8.5/bin/gradle /usr/local/bin/gradle && \
    rm -rf /var/lib/apt/lists/*

# 复制 cartisan-boot 到 /cartisan-boot（settings.gradle.kts 引用 ../../cartisan-boot）
COPY cartisan-boot /cartisan-boot/

# 设置工作目录
WORKDIR /app

# 复制 Gradle init 配置（需要在项目文件之前）
COPY aieducenter-platform-admin/docker/test/init.gradle /app/server/init.gradle.d/repositories.gradle

# 复制项目文件（从 aieducenter-platform-admin/）
COPY aieducenter-platform-admin/server/gradlew /app/server/
COPY aieducenter-platform-admin/server/gradle/wrapper/gradle-wrapper.jar /app/server/gradle/wrapper/
COPY aieducenter-platform-admin/server/gradle/wrapper/gradle-wrapper.properties /app/server/gradle/wrapper/
COPY aieducenter-platform-admin/server/build.gradle.kts /app/server/
COPY aieducenter-platform-admin/server/settings.gradle.kts /app/server/
COPY aieducenter-platform-admin/server/src /app/server/src

# 预下载依赖（解决 TLS 问题）
RUN cd /app/server && \
    gradle dependencies --init-script=/app/server/init.gradle.d/repositories.gradle || true

# 复制 Gradle init 配置（使用 Maven Central 而不是 plugins.gradle.org）
COPY aieducenter-platform-admin/docker/test/init.gradle /app/server/init.gradle.d/repositories.gradle

# Gradle 配置：禁用守护进程，设置 JVM TLS 选项
ENV GRADLE_USER_HOME=/app/server/.gradle
ENV GRADLE_OPTS="-Dorg.gradle.daemon=false -Djdk.tls.client.protocols=TLSv1.2,TLSv1.3 -Dhttps.protocols=TLSv1.2,TLSv1.3"
ENV JAVA_OPTS="-Djdk.tls.client.protocols=TLSv1.2,TLSv1.3 -Dhttps.protocols=TLSv1.2,TLSv1.3"
ENV JAVA_TOOL_OPTIONS="-Djdk.tls.client.protocols=TLSv1.2,TLSv1.3 -Dhttps.protocols=TLSv1.2,TLSv1.3"

# 切换到 server 目录运行测试
WORKDIR /app/server

# 等待数据库和 Redis 就绪，然后运行测试
CMD ["sh", "-c", "echo 'Waiting for services...' && \
  for i in $(seq 1 60); do \
    nc -zv postgres 5432 2>&1 | grep -q succeeded && break || echo 'Postgres not ready...'; \
    sleep 2; \
  done && \
  for i in $(seq 1 30); do \
    nc -zv redis 6379 2>&1 | grep -q succeeded && break || echo 'Redis not ready...'; \
    sleep 1; \
  done && \
  echo 'Services ready! Running tests...' && \
  gradle test --no-daemon --init-script=/app/server/init.gradle.d/repositories.gradle"]
